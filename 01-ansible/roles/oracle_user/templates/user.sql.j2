-- generated by the oracle_user role; prints CHANGED: <statement> for every change, nothing when in state
set serveroutput on feedback off heading off verify off
whenever sqlerror exit failure
alter session set container = {{ pdb }};
set serveroutput on
declare
  n number;
  procedure ex(stmt varchar2, shown varchar2 default null) is
  begin
    execute immediate stmt;
    dbms_output.put_line('CHANGED: ' || nvl(shown, stmt));
  end;
begin
{% for r in roles_here %}
  select count(*) into n from dba_roles where role = upper('{{ r.name }}');
  if n = 0 then ex('create role {{ r.name }}'); end if;
{%   for g in r.object_grants %}
  select count(*) into n from dba_tab_privs where grantee = upper('{{ r.name }}')
     and privilege = upper('{{ g.split(' on ')[0] }}')
     and owner || '.' || table_name = upper('{{ g.split(' on ')[1] }}');
  if n = 0 then ex('grant {{ g }} to {{ r.name }}'); end if;
{%   endfor %}
{% endfor %}
{% for u in users_here %}
  select count(*) into n from dba_users where username = upper('{{ u.name }}');
  if n = 0 then
    -- password only on creation (like the Ansible user module's update_password: on_create)
    ex('create user {{ u.name }} identified by "{{ vault_user_passwords[u.name] }}" profile {{ u.profile }}',
       'create user {{ u.name }} identified by ******** profile {{ u.profile }}');
  else
    select count(*) into n from dba_users where username = upper('{{ u.name }}') and profile = upper('{{ u.profile }}');
    if n = 0 then ex('alter user {{ u.name }} profile {{ u.profile }}'); end if;
  end if;
{%   for p in u.system_privs %}
  select count(*) into n from dba_sys_privs where grantee = upper('{{ u.name }}') and privilege = upper('{{ p }}');
  if n = 0 then ex('grant {{ p }} to {{ u.name }}'); end if;
{%   endfor %}
{%   for r in u.roles %}
  select count(*) into n from dba_role_privs where grantee = upper('{{ u.name }}') and granted_role = upper('{{ r }}');
  if n = 0 then ex('grant {{ r }} to {{ u.name }}'); end if;
{%   endfor %}
{% endfor %}
end;
/
exit
